#!/bin/bash
set -euo pipefail
project_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$project_root"
app_dir="$project_root/dist/Vimac.app"
if [[ $# -ne 0 ]]; then
    printf '%s\n' '用法：scripts/build-app（固定输出 dist/Vimac.app）' >&2
    exit 2
fi
# 覆盖正在运行的签名二进制会让该进程的代码身份失效，权限检查也会失真。
for process_id in $(pgrep -x Vimac || true); do
    if [[ "$(ps -p "$process_id" -o comm=)" == "$app_dir/Contents/MacOS/Vimac" ]]; then
        printf '%s\n' '目标应用正在运行，请先退出；不会覆盖运行中的应用。' >&2
        exit 1
    fi
done
swift build -c release
bin_dir="$(swift build -c release --show-bin-path)"
mkdir -p "$app_dir/Contents/MacOS" "$app_dir/Contents/Helpers"
cp "$bin_dir/Vimac" "$app_dir/Contents/MacOS/Vimac"
cp "$bin_dir/VimacFixture" "$app_dir/Contents/Helpers/VimacFixture"
cp Resources/Info.plist "$app_dir/Contents/Info.plist"
# 本地 ad-hoc 签名不等于 Developer ID 分发签名或公证。
codesign --force --sign - "$app_dir/Contents/Helpers/VimacFixture"
codesign --force --sign - "$app_dir"
codesign --verify --strict "$app_dir"
printf '%s\n' "$app_dir"
